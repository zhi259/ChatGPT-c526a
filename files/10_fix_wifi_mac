#!/bin/ash

[ "$ACTION" = "add" ] || exit 0

PHYNBR=${DEVPATH##*/phy}
case "$PHYNBR" in
	''|*[!0-9]*) exit 0 ;;
esac

. /lib/functions.sh
. /lib/functions/system.sh

board=$(board_name)

case "$board" in
	hiwifi,c526a)
		[ "$PHYNBR" -eq 0 ] && \
			mtd_get_mac_ascii bdinfo "Vfac_mac " > "/sys${DEVPATH}/macaddress"
		;;
	*)
		;;
esac
