#!/bin/ash

[ "$ACTION" = "add" ] || exit 0

PHYNBR=${DEVPATH##*/phy}
case "$PHYNBR" in
	''|*[!0-9]*) exit 0 ;;
esac

. /lib/functions.sh
. /lib/functions/system.sh

board=$(board_name)

case "$board" in
	hiwifi,c526a)
		if [ "$PHYNBR" -eq 0 ]; then
			lan_mac=$(mtd_get_mac_ascii bdinfo "Vfac_mac ")
			if echo "$lan_mac" | grep -Eq "^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$"; then
				printf '%s' "$lan_mac" > "/sys${DEVPATH}/macaddress"
			fi
		fi
		;;
	*)
		;;
esac
