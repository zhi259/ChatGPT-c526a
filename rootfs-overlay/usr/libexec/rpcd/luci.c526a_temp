#!/bin/sh
# Read-only wireless temperature endpoint for the C526A LuCI overview.
# Does not reload drivers, rescan PCIe, or change calibration data.

get_data() {
    items=""
    SYSFS_ROOT="${C526A_SYSFS_ROOT:-/sys}"

    for hwmon in "$SYSFS_ROOT"/class/hwmon/hwmon*; do
        [ -d "$hwmon" ] || continue
        name="$(cat "$hwmon/name" 2>/dev/null)"
        devpath="$(readlink -f "$hwmon/device" 2>/dev/null)"
        id=""
        label=""
        case "$name:$devpath" in
            mt7615_phy0:*)
                id="wifi24"
                label="2.4 GHz 无线模块（MT7615E）"
                ;;
            ath10k_hwmon:*a000000.wifi*)
                id="wifi5a"
                label="5 GHz 无线模块 1（QCA4019）"
                ;;
            ath10k_hwmon:*a800000.wifi*)
                id="wifi5b"
                label="5 GHz 无线模块 2（QCA4019）"
                ;;
            *)
                continue
                ;;
        esac

        for input in "$hwmon"/temp*_input; do
            [ -r "$input" ] || continue
            raw="$(cat "$input" 2>/dev/null)"
            case "$raw" in
                ''|*[!0-9]*) continue ;;
            esac
            [ "$raw" -gt 0 ] 2>/dev/null || continue
            [ "$raw" -le 150000 ] 2>/dev/null || continue
            whole=$((raw / 1000))
            tenth=$(((raw % 1000 + 50) / 100))
            if [ "$tenth" -ge 10 ]; then
                whole=$((whole + 1))
                tenth=0
            fi
            temp="${whole}.${tenth}"
            item="{\"id\":\"$id\",\"name\":\"$label\",\"temp_c\":\"$temp\"}"
            if [ -n "$items" ]; then
                items="$items,$item"
            else
                items="$item"
            fi
            break
        done
    done

    if [ -n "$items" ]; then
        printf '{"available":true,"sensors":[%s]}\n' "$items"
    else
        printf '{"available":false,"sensors":[]}\n'
    fi
}

case "$1" in
    list)
        printf '{"getData":{}}\n'
        ;;
    call)
        case "$2" in
            getData)
                read -r _input 2>/dev/null || true
                get_data
                ;;
            *)
                printf '{}\n'
                ;;
        esac
        ;;
esac
